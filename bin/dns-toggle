set -e
CONF_FILE="/etc/systemd/resolved.conf"

was_immutable=0
if lsattr "$CONF_FILE" 2>/dev/null | awk '{print $1}' | grep -q 'i'; then
    was_immutable=1
    chattr -i "$CONF_FILE"
fi

relock() {
    [ "$was_immutable" -eq 1 ] && chattr +i "$CONF_FILE" || true
}
trap relock EXIT

if grep -q '94.140.14.14' "$CONF_FILE"; then
    sed -i 's/^DNS=.*/DNS=1.1.1.2#security.cloudflare-dns.com 1.0.0.2#security.cloudflare-dns.com/' "$CONF_FILE"
    sed -i 's|^FallbackDNS=.*|FallbackDNS=9.9.9.9#dns.quad9.net 1.1.1.2#security.cloudflare-dns.com|' "$CONF_FILE"
else
    sed -i 's/^DNS=.*/DNS=94.140.14.14#dns.adguard-dns.com 94.140.15.15#dns.adguard-dns.com/' "$CONF_FILE"
    sed -i 's|^FallbackDNS=.*|FallbackDNS=9.9.9.9#dns.quad9.net 1.1.1.2#security.cloudflare-dns.com|' "$CONF_FILE"
fi

systemctl restart systemd-resolved
