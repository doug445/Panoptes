# netwatch — monitor for network probes/attacks, send desktop notifications
# Watches firewalld or ufw dropped packets + new inbound connections + ARP anomalies

set -euo pipefail

LOG_DIR="${HOME}/.local/share/netwatch"
LOG_FILE="${LOG_DIR}/events.log"
POLL_INTERVAL=10
ALERT_THRESHOLD=5          # notify after this many drops from same IP in window
ALERT_WINDOW=60            # seconds
SUMMARY_INTERVAL=300       # summary notification every 5 min if activity
SUSTAIN_WINDOWS=3          # consecutive hot windows that make a sustained attack

# Notifications are silent except for a real, sustained attack. A busy LAN
# keeps the firewall dropping all day -- discovery replies from TVs and
# speakers to random high UDP ports, late TCP ACKs from a CDN after conntrack
# forgot the flow -- and a beep every five minutes for that trains you to
# ignore the one that matters. What still sounds:
#   - a sustained attack: one source sending ALERT_THRESHOLD real probes
#     (a TCP SYN, or UDP to a service port below 32768) in each of
#     SUSTAIN_WINDOWS consecutive windows; one alert per episode
#   - an ARP spoof: the gateway's MAC changed on the same network
# Silence needs the suppress-sound hint AND an urgency below critical:
# Cinnamon sounds when `!silent || urgency >= HIGH` (see persistwatch).
# NETWATCH_SOUND=1 makes every notification sound, as before.
NETWATCH_SOUND="${NETWATCH_SOUND:-0}"

mkdir -p "$LOG_DIR"

# Resolve DBUS for notify-send from a systemd service
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    export DBUS_SESSION_BUS_ADDRESS
fi

notify() {  # $1 urgency, $2 title, $3 body, $4 "loud" to make a sound
    local urgency="$1" title="$2" body="$3" sound="${4:-quiet}"
    local -a hints=(--hint=boolean:suppress-sound:true)
    # A loud alert stays on screen until dismissed.
    [[ "$sound" == loud ]] && hints=(--hint=boolean:resident:true)
    [[ "$NETWATCH_SOUND" == 1 ]] && hints=()
    # KDE pins critical notifications regardless of -t; downgrade to normal
    # and prepend marker to title so alerts still look urgent.
    local icon="network-error"
    if [[ "$urgency" == "critical" ]]; then
        urgency="normal"
        title="⚠ $title"
        icon="security-low"
    fi
    # --hint=string:desktop-entry:netwatch — so KDE Plasma keeps entries in the
    # notification history (bell icon). Without it, Plasma 6 treats the app as
    # unknown and discards notifications after the popup timeout.
    notify-send -u "$urgency" -t 15000 -i "$icon" -a "NetWatch" \
        --hint=string:desktop-entry:netwatch "${hints[@]}" \
        "$title" "$body" 2>/dev/null || true
}

log_event() {
    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$ts] $1" >> "$LOG_FILE"
}

# Track per-IP drop counts within the alert window
declare -A ip_counts
declare -A ip_first_seen
declare -A ip_alerted
declare -A ip_hits          # real probes (see is_probe) from this IP in its window
declare -A ip_hot           # set once ip_hits reached the threshold this window
# Hot-window streaks outlive the window and the summary reset.
declare -A ip_streak ip_last_hot ip_sustained
sustained_attacks=0
last_summary=$(date +%s)
last_check=$last_summary
total_drops=0
unique_ips=0

reset_counters() {
    ip_counts=()
    ip_first_seen=()
    ip_alerted=()
    ip_hits=()
    ip_hot=()
    sustained_attacks=0
    total_drops=0
    unique_ips=0
}

# Filter out broadcast/discovery noise that isn't a real probe
is_noise() {
    local src="$1" dst="$2" dpt="$3"
    [[ "$src" == "unknown" || "$src" == 127.* || "$src" == "::1" || "$src" == fe80:* ]] && return 0
    [[ "$dst" == 255.255.255.255 || "$dst" == 224.* || "$dst" == *.255 ]] && return 0
    [[ "$dst" == ff[0-9a-f][0-9a-f]:* || "$dst" == fe80:* ]] && return 0
    case "$dpt" in
        5353)  return 0 ;;  # mDNS
        1900)  return 0 ;;  # SSDP/UPnP
        137)   return 0 ;;  # NetBIOS name service
        138)   return 0 ;;  # NetBIOS datagram
        15600) return 0 ;;  # Samsung Smart View
        15500) return 0 ;;  # LG Smart Share
        3702)  return 0 ;;  # WS-Discovery
    esac
    return 1
}

# A real probe opens something: a TCP SYN without ACK, or UDP to a service
# port. Late TCP replies (ACK/FIN/RST after conntrack forgot the flow) and UDP
# to an ephemeral port (a discovery reply arriving too late) are drops, but
# nobody is knocking. $1 = kernel log line, $2 = proto, $3 = dpt
is_probe() {
    case "$2" in
        TCP) [[ "$1" == *" SYN "* && "$1" != *" ACK "* ]] ;;
        UDP) [[ "$3" =~ ^[0-9]+$ ]] && (( $3 < 32768 )) ;;
        *)   return 1 ;;
    esac
}

process_drop() {
    local src_ip="$1" proto="$2" dpt="$3" probe="$4"
    local now
    now=$(date +%s)

    # Expire old entries outside the alert window
    for ip in "${!ip_first_seen[@]}"; do
        if (( now - ip_first_seen[$ip] > ALERT_WINDOW )); then
            unset "ip_counts[$ip]" "ip_first_seen[$ip]" "ip_alerted[$ip]" "ip_hits[$ip]" "ip_hot[$ip]"
        fi
    done
    # A streak breaks when a source goes a full window without being hot;
    # that also re-arms its sustained-attack alert.
    for ip in "${!ip_last_hot[@]}"; do
        if (( now - ip_last_hot[$ip] > 2 * ALERT_WINDOW )); then
            unset "ip_streak[$ip]" "ip_last_hot[$ip]" "ip_sustained[$ip]"
        fi
    done

    # Count this drop
    if [[ -z "${ip_counts[$src_ip]:-}" ]]; then
        ip_counts[$src_ip]=0
        ip_hits[$src_ip]=0
        ip_first_seen[$src_ip]=$now
        (( unique_ips++ )) || true
    fi
    (( ip_counts[$src_ip]++ )) || true
    (( total_drops++ )) || true
    (( probe )) && { (( ip_hits[$src_ip]++ )) || true; }

    log_event "DROP src=$src_ip proto=$proto dpt=$dpt$( (( probe )) && echo ' probe')"

    # Alert if threshold crossed for this IP (silent: usually LAN chatter)
    if (( ip_counts[$src_ip] >= ALERT_THRESHOLD )) && [[ -z "${ip_alerted[$src_ip]:-}" ]]; then
        ip_alerted[$src_ip]=1
        notify critical "Port Scan Detected" "Source: $src_ip\n${ip_counts[$src_ip]} probes in ${ALERT_WINDOW}s (${proto})"
        log_event "ALERT port_scan src=$src_ip count=${ip_counts[$src_ip]}"
    fi

    # A hot window: enough real probes from this source. Enough consecutive
    # hot windows make a sustained attack, the one drop alert that sounds.
    if (( ip_hits[$src_ip] >= ALERT_THRESHOLD )) && [[ -z "${ip_hot[$src_ip]:-}" ]]; then
        ip_hot[$src_ip]=1
        ip_last_hot[$src_ip]=$now
        ip_streak[$src_ip]=$(( ${ip_streak[$src_ip]:-0} + 1 ))
        if (( ip_streak[$src_ip] >= SUSTAIN_WINDOWS )) && [[ -z "${ip_sustained[$src_ip]:-}" ]]; then
            ip_sustained[$src_ip]=1
            (( sustained_attacks++ )) || true
            notify critical "Sustained Attack" "Source: $src_ip\nProbing nonstop for $(( ip_streak[$src_ip] * ALERT_WINDOW / 60 )) min (${proto}, latest port ${dpt})\nInvestigate: probesource $src_ip" loud
            log_event "ALERT sustained_attack src=$src_ip windows=${ip_streak[$src_ip]}"
        fi
    fi
}

check_arp_spoofing() {
    local gateway_ip gateway_mac
    gateway_ip=$(ip route show default | awk '/default/{print $3; exit}')
    [[ -z "$gateway_ip" ]] && return

    gateway_mac=$(ip neigh show "$gateway_ip" 2>/dev/null | awk '{print $5; exit}')
    [[ -z "$gateway_mac" ]] && return

    local stored_mac stored_ip
    stored_mac=$(cat "$LOG_DIR/gateway_mac" 2>/dev/null || true)
    stored_ip=$(cat "$LOG_DIR/gateway_ip" 2>/dev/null || true)

    # A different gateway address is a different network (e.g. an Ethernet move
    # to another LAN), not a spoofed MAC — start over rather than alarm.
    if [[ -n "$stored_ip" && "$stored_ip" != "$gateway_ip" ]]; then
        log_event "ARP gateway changed $stored_ip -> $gateway_ip (re-learning)"
        stored_mac=""
    fi

    if [[ -z "$stored_mac" ]]; then
        echo "$gateway_mac" > "$LOG_DIR/gateway_mac"
        echo "$gateway_ip" > "$LOG_DIR/gateway_ip"
        log_event "ARP gateway=$gateway_ip mac=$gateway_mac (stored)"
    elif [[ "$stored_mac" != "$gateway_mac" ]]; then
        notify critical "ARP Spoofing Detected!" "Gateway $gateway_ip MAC changed!\nWas: $stored_mac\nNow: $gateway_mac\n\nSomeone may be intercepting your traffic!" loud
        log_event "ALERT arp_spoof gateway=$gateway_ip old=$stored_mac new=$gateway_mac"
        echo "$gateway_mac" > "$LOG_DIR/gateway_mac"
    fi
}

check_new_network() {
    local current_ssid
    # --rescan no: read NetworkManager's cache, do not trigger a Wi-Fi scan every poll.
    current_ssid=$(nmcli -t -f active,ssid dev wifi list --rescan no 2>/dev/null | grep '^yes:' | cut -d: -f2- || true)
    local stored_ssid
    stored_ssid=$(cat "$LOG_DIR/current_ssid" 2>/dev/null || true)

    if [[ "$current_ssid" != "$stored_ssid" ]] && [[ -n "$current_ssid" ]]; then
        echo "$current_ssid" > "$LOG_DIR/current_ssid"
        # Reset gateway MAC when network changes
        rm -f "$LOG_DIR/gateway_mac"
        log_event "NETWORK changed to '$current_ssid'"
        notify normal "Network Changed" "Connected to: $current_ssid\nMonitoring started."
    fi
}

# ── Startup ─────────────────────────────────────────────────────────────
log_event "NetWatch started (pid=$$)"
notify normal "NetWatch Active" "Monitoring for network probes and attacks."
check_new_network
check_arp_spoofing

# ── Main event loop ─────────────────────────────────────────────────────
# Single-process design: process substitution keeps the while loop in this
# shell so counters and associative arrays are shared — no subshell isolation.
open_journal() { exec 3< <(journalctl -k -f --no-pager -o short 2>/dev/null); }
open_journal

while true; do
    rc=0
    read -r -t "$POLL_INTERVAL" line <&3 || rc=$?
    if (( rc == 0 )); then
        # firewalld logs "<zone>_DROP" / "FINAL_REJECT"; ufw logs "[UFW BLOCK]".
        if [[ "$line" == *"_DROP"* ]] || [[ "$line" == *"FINAL_REJECT"* ]] || [[ "$line" == *"[UFW BLOCK]"* ]]; then
            src_ip=$(echo "$line" | grep -oP 'SRC=\K[0-9a-fA-F.:]+' || echo "unknown")
            proto=$(echo "$line" | grep -oP 'PROTO=\K\w+' || echo "?")
            dpt=$(echo "$line" | grep -oP 'DPT=\K\d+' || echo "?")
            dst_ip=$(echo "$line" | grep -oP 'DST=\K[0-9a-fA-F.:]+' || echo "")

            if ! is_noise "$src_ip" "$dst_ip" "$dpt"; then
                probe=0; is_probe "$line" "$proto" "$dpt" && probe=1
                process_drop "$src_ip" "$proto" "$dpt" "$probe"
            fi
        fi
    elif (( rc < 128 )); then
        # EOF, not a timeout: journalctl went away. Without this the read fails
        # instantly on every pass and the loop spins at 100% CPU.
        log_event "WARN journalctl exited (read rc=$rc); re-opening kernel log in ${POLL_INTERVAL}s"
        exec 3<&-
        sleep "$POLL_INTERVAL"
        open_journal
    fi

    # Periodic checks. The network check must run first: it resets the stored
    # gateway MAC on an SSID change, so the ARP check does not see the new
    # network's gateway as a spoofed one (same order as at startup).
    now=$(date +%s)
    if (( now - last_check >= POLL_INTERVAL )); then
        check_new_network
        check_arp_spoofing
        last_check=$now
    fi

    # Periodic summary
    if (( total_drops > 0 && now - last_summary >= SUMMARY_INTERVAL )); then
        summary="${total_drops} dropped packets from ${unique_ips} source(s) in last ${SUMMARY_INTERVAL}s"
        (( sustained_attacks )) && summary+="\n${sustained_attacks} sustained attack(s) -- see the alert"
        notify low "NetWatch Summary" "$summary"
        log_event "SUMMARY drops=$total_drops unique_ips=$unique_ips"
        last_summary=$now
        reset_counters
    fi
done
