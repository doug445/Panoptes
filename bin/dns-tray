import os
import subprocess
import sys

# Daemonize: detach from terminal so closing the shell doesn't kill the tray
if os.fork() > 0:
    sys.exit(0)
os.setsid()

CONF_FILE = '/etc/systemd/resolved.conf'

def check_status():
    try:
        with open(CONF_FILE) as f:
            return '94.140.14.14' in f.read()
    except (OSError, ValueError):
        # OSError: file missing or unreadable. ValueError covers
        # UnicodeDecodeError on a corrupt resolved.conf.
        return False

def do_toggle():
    subprocess.Popen(
        ['sudo', '/usr/local/bin/dns-toggle'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )

desktop = os.environ.get('XDG_CURRENT_DESKTOP', '').lower()

if 'kde' in desktop:
    # --- KDE PLASMA (QT6) ---
    from PyQt6.QtCore import QTimer
    from PyQt6.QtGui import QIcon
    from PyQt6.QtWidgets import QApplication, QSystemTrayIcon

    def toggle(reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            on = check_status()
            do_toggle()
            if on:
                subprocess.Popen(['notify-send', 'AdGuard DNS', 'Disabled — using default DNS', '--icon=security-low'])
            else:
                subprocess.Popen(['notify-send', 'AdGuard DNS', 'Enabled — encrypted DNS active', '--icon=security-high'])
            QTimer.singleShot(2000, update_ui)

    def update_ui():
        if check_status():
            tray.setIcon(icon_on)
            tray.setToolTip("AdGuard DNS on")
        else:
            tray.setIcon(icon_off)
            tray.setToolTip("AdGuard DNS off")

    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    home = os.path.expanduser('~')
    icon_on  = QIcon(f"{home}/.local/share/icons/adguard-green.svg")
    icon_off = QIcon(f"{home}/.local/share/icons/adguard-red.svg")
    tray = QSystemTrayIcon()
    update_ui()
    tray.setVisible(True)
    tray.activated.connect(toggle)
    timer = QTimer()
    timer.timeout.connect(update_ui)
    timer.start(3000)
    sys.exit(app.exec())

elif 'cinnamon' in desktop or 'x-cinnamon' in desktop:
    # --- CINNAMON (XAPP/GTK) ---
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('XApp', '1.0')
    from gi.repository import GLib, Gtk, XApp

    def on_click(status_icon, x, y, button, time, panel_position):
        if button != 1:
            return
        on = check_status()
        do_toggle()
        if on:
            subprocess.Popen(['notify-send', 'AdGuard DNS', 'Disabled — using default DNS', '--icon=security-low'])
        else:
            subprocess.Popen(['notify-send', 'AdGuard DNS', 'Enabled — encrypted DNS active', '--icon=security-high'])
        GLib.timeout_add(2000, lambda: update_ui() or GLib.SOURCE_REMOVE)

    def update_ui():
        if check_status():
            icon.set_icon_name(icon_on)
            icon.set_tooltip_text("AdGuard DNS on")
        else:
            icon.set_icon_name(icon_off)
            icon.set_tooltip_text("AdGuard DNS off")

    def poll_status():
        update_ui()
        return GLib.SOURCE_CONTINUE

    home = os.path.expanduser('~')
    icon_on  = f"{home}/.local/share/icons/adguard-green.svg"
    icon_off = f"{home}/.local/share/icons/adguard-red.svg"
    icon = XApp.StatusIcon()
    icon.connect("button-release-event", on_click)
    update_ui()
    GLib.timeout_add(3000, poll_status)
    Gtk.main()

else:
    print(f"Unsupported desktop environment: {desktop}")
    sys.exit(1)
