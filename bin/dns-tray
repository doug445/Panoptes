import os
import subprocess
import sys

# Daemonize: detach from terminal so closing the shell doesn't kill the tray
if os.fork() > 0:
    sys.exit(0)
os.setsid()

CONF_FILE = '/etc/systemd/resolved.conf'

def check_status():
    try:
        with open(CONF_FILE) as f:
            return '94.140.14.14' in f.read()
    except (OSError, ValueError):
        # OSError: file missing or unreadable. ValueError covers
        # UnicodeDecodeError on a corrupt resolved.conf.
        return False

def notify(body, icon):
    subprocess.Popen(['notify-send', 'DNS resolver', body, f'--icon={icon}'],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def do_toggle():
    # Non-interactive sudo: the tray has no terminal to ask for a password on.
    # A missing NOPASSWD rule must surface as a notification, not silence.
    try:
        return subprocess.run(['sudo', '-n', '/usr/local/bin/dns-toggle'],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=30, check=False).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


SUDO_HINT = ('dns-toggle failed — is passwordless sudo configured? '
             '(/etc/sudoers.d: <user> ALL=(root) NOPASSWD: /usr/local/bin/dns-toggle)')


def flip_resolver():
    """Toggle, then say what happened. Returns True when the toggle ran."""
    on = check_status()
    if not do_toggle():
        notify(SUDO_HINT, 'dialog-error')
        return False
    if on:
        notify('Cloudflare 1.1.1.2 — malware filtering, no ad blocking', 'security-medium')
    else:
        notify('AdGuard 94.140.14.14 — ad and tracker filtering', 'security-high')
    return True

desktop = os.environ.get('XDG_CURRENT_DESKTOP', '').lower()

if 'kde' in desktop:
    # --- KDE PLASMA (QT6) ---
    from PyQt6.QtCore import QTimer
    from PyQt6.QtGui import QIcon
    from PyQt6.QtWidgets import QApplication, QSystemTrayIcon

    def toggle(reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            flip_resolver()
            QTimer.singleShot(2000, update_ui)

    def update_ui():
        if check_status():
            tray.setIcon(icon_ag)
            tray.setToolTip("AdGuard DNS — 94.140.14.14, DoT")
        else:
            tray.setIcon(icon_cf)
            tray.setToolTip("Cloudflare 1.1.1.2 security — DoT")

    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    home = os.path.expanduser('~')
    icon_ag = QIcon(f"{home}/.local/share/icons/adguard-green.svg")
    icon_cf = QIcon(f"{home}/.local/share/icons/cloudflare-shield.svg")
    tray = QSystemTrayIcon()
    update_ui()
    tray.setVisible(True)
    tray.activated.connect(toggle)
    timer = QTimer()
    timer.timeout.connect(update_ui)
    timer.start(3000)
    sys.exit(app.exec())

else:
    # --- GTK: Cinnamon, MATE, XFCE, anything else ---
    # XApp.StatusIcon where libxapp is present (Cinnamon, MATE, XFCE on Mint
    # and its relatives): it speaks StatusNotifierItem and falls back to a
    # legacy status icon by itself. Elsewhere Gtk.StatusIcon, which every X11
    # notification area still accepts.
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import GLib, Gtk
    try:
        gi.require_version('XApp', '1.0')
        from gi.repository import XApp
        use_xapp = True
    except (ValueError, ImportError):
        from gi.repository import GdkPixbuf
        use_xapp = False

    def flip():
        flip_resolver()
        GLib.timeout_add(2000, lambda: update_ui() or GLib.SOURCE_REMOVE)

    def update_ui():
        if check_status():
            path, text = icon_ag, "AdGuard DNS — 94.140.14.14, DoT"
        else:
            path, text = icon_cf, "Cloudflare 1.1.1.2 security — DoT"
        if use_xapp:
            icon.set_icon_name(path)
        else:
            icon.set_from_pixbuf(pixbufs[path])
        icon.set_tooltip_text(text)

    def poll_status():
        update_ui()
        return GLib.SOURCE_CONTINUE

    home = os.path.expanduser('~')
    icon_ag = f"{home}/.local/share/icons/adguard-green.svg"
    icon_cf = f"{home}/.local/share/icons/cloudflare-shield.svg"
    if use_xapp:
        def on_click(_icon, _x, _y, button, _time, _pos):
            if button == 1:
                flip()
        icon = XApp.StatusIcon()
        icon.connect("button-release-event", on_click)
    else:
        pixbufs = {p: GdkPixbuf.Pixbuf.new_from_file_at_size(p, 22, 22)
                   for p in (icon_ag, icon_cf)}
        icon = Gtk.StatusIcon()
        icon.connect("activate", lambda _i: flip())
    update_ui()
    GLib.timeout_add(3000, poll_status)
    Gtk.main()
