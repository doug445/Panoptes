# Cloudflare WARP tray. Left-click: connect / disconnect. Right-click:
# Tear Down / Rebuild / Heal now / Status (all via the root helper), and the
# Proton VPN fallback: Connect (parks WARP first) / Disconnect (rebuilds WARP).
#
# Icon: green W = WARP on; red W = WARP off or torn down; orange W = WARP
# parked for Proton VPN but Proton VPN is not up; yellow circle, black P =
# Proton VPN on.
#
# Needs passwordless sudo for the helper, e.g. in /etc/sudoers.d/warp-killswitch:
#   <user> ALL=(root) NOPASSWD: /usr/local/bin/warp-killswitch
import fcntl
import html
import os
import shutil
import subprocess
import sys
import threading

# Daemonize: detach from terminal so closing the shell doesn't kill the tray
if os.fork() > 0:
    sys.exit(0)
os.setsid()

# Single-instance guard. Held open deliberately for the lifetime of the
# process: closing this file releases the flock. Do not use a `with` block.
_lock_fp = open(f"/run/user/{os.getuid()}/warp-tray.lock", "w")  # noqa: SIM115
try:
    fcntl.flock(_lock_fp, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(0)  # another instance holds the lock

KILLSWITCH = '/usr/local/bin/warp-killswitch'
KILL_MARKERS = ('/var/lib/warp-killswitch/killed',
                '/etc/systemd/resolved.conf.warpkill-bak')
PARK_MARKER = '/var/lib/warp-killswitch/parked'
PROTON = shutil.which('proton-fallback') or os.path.expanduser('~/.local/bin/proton-fallback')
HAVE_PROTON = os.access(PROTON, os.X_OK)
DEVNULL = subprocess.DEVNULL
SUDO_HINT = (f'is passwordless sudo configured? (/etc/sudoers.d: '
             f'<user> ALL=(root) NOPASSWD: {KILLSWITCH})')


def notify(title, body, icon):
    subprocess.Popen(['notify-send', '-a', 'Cloudflare WARP', '-i', icon,
                      '--hint=string:desktop-entry:warp-tray', title, body],
                     stdout=DEVNULL, stderr=DEVNULL)


def check_status():
    # Time-bounded: a wedged warp-svc must not freeze the tray.
    try:
        res = subprocess.run(['warp-cli', '--accept-tos', 'status'],
                             capture_output=True, text=True, check=False, timeout=8)
        first = res.stdout.splitlines()[0] if res.stdout else ''
        return first.split(':', 1)[-1].strip() == 'Connected'
    except (OSError, subprocess.SubprocessError, IndexError):
        return False


def is_killed():
    return any(os.path.exists(m) for m in KILL_MARKERS)


def is_parked():
    return os.path.exists(PARK_MARKER) and is_killed()


def proton_connected():
    if not HAVE_PROTON:
        return False
    try:
        return subprocess.run([PROTON, 'state'], stdout=DEVNULL, stderr=DEVNULL,
                              check=False, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def warp_switch(action):
    # 'connect' or 'disconnect'. Tearing the tunnel down kills every DNS lookup
    # in flight over it; those fail DNSSEC with 'failed-auxiliary' and resolved
    # caches the failure, which reads as "no internet". Flush afterwards, and
    # drop the per-server feature grades learned over the old transport.
    def run():
        subprocess.run(['timeout', '20', 'warp-cli', '--accept-tos', action],
                       stdout=DEVNULL, stderr=DEVNULL, check=False)
        for cmd in (['resolvectl', 'flush-caches'],
                    ['resolvectl', 'reset-server-features'],
                    ['timeout', '20', 'nmcli', 'networking', 'connectivity', 'check']):
            subprocess.run(cmd, stdout=DEVNULL, stderr=DEVNULL, check=False)
    threading.Thread(target=run, daemon=True).start()


def run_helper(*args, timeout=300):
    """sudo -n the root helper. Returns (rc, stderr); rc -1 when it could not run.

    The helper posts its own result notifications. What it cannot report is
    never having run at all — no NOPASSWD rule, a missing binary — so that is
    reported here, from its stderr.
    """
    try:
        res = subprocess.run(['sudo', '-n', KILLSWITCH, *args], capture_output=True,
                             text=True, check=False, timeout=timeout)
    except subprocess.TimeoutExpired:
        return -1, 'timed out'
    except OSError as e:
        return -1, str(e)
    if res.returncode != 0 and ('sudo:' in res.stderr or 'password' in res.stderr
                                or 'not found' in res.stderr):
        return -1, res.stderr.strip()
    return res.returncode, res.stderr.strip()


def killswitch(action):
    # 'down' | 'up' | 'heal'.
    def run():
        rc, err = run_helper(action)
        if rc == -1:
            notify('Cloudflare WARP', f'{action} did not run: {err or "unknown error"} — {SUDO_HINT}',
                   'network-error')
            return
        subprocess.run(['resolvectl', 'flush-caches'], stdout=DEVNULL, stderr=DEVNULL, check=False)
    threading.Thread(target=run, daemon=True).start()
    if action == 'down':
        notify('Cloudflare WARP', 'Tearing down the WARP stack…', 'network-error')
    elif action == 'up':
        notify('Cloudflare WARP', 'Rebuilding WARP + restoring DNS…', 'network-vpn')
    else:
        notify('Cloudflare WARP', 'Running heal — checking link, tunnel and DNS…', 'network-vpn')


def proton(action):
    # 'on' | 'off'. proton-fallback parks/unparks WARP and posts its own notifications.
    def run():
        try:
            subprocess.run([PROTON, action], stdout=DEVNULL, stderr=DEVNULL,
                           check=False, timeout=600)
        except (OSError, subprocess.SubprocessError) as e:
            notify('Proton VPN', f'proton-fallback {action} failed: {e}', 'network-error')
    threading.Thread(target=run, daemon=True).start()


def show_status():
    def run():
        rc, err = run_helper('status', timeout=60)
        if rc == -1:
            out = f'status did not run: {err} — {SUDO_HINT}'
        else:
            try:
                res = subprocess.run(['sudo', '-n', KILLSWITCH, 'status'], capture_output=True,
                                     text=True, check=False, timeout=60)
                out = res.stdout.strip() or res.stderr.strip() or '(no output)'
            except (OSError, subprocess.SubprocessError) as e:
                out = f'status failed: {e}'
        if HAVE_PROTON:
            try:
                p = subprocess.run([PROTON, 'status'], capture_output=True, text=True,
                                   check=False, timeout=30)
                out += '\n' + p.stdout.strip()
            except (OSError, subprocess.SubprocessError):
                pass
        notify('WARP status', html.escape(out), 'network-vpn')
    threading.Thread(target=run, daemon=True).start()


LABEL_DOWN = "\U0001F534  Last Resort: Tear Down (reset internet)"
LABEL_UP = "\U0001F7E2  Rebuild WARP + restore DNS"
LABEL_HEAL = "\U0001FA7A  Heal now (auto-repair)"
LABEL_STATUS = "ℹ️  Status"
LABEL_PROTON_ON = "\U0001F7E1  Proton VPN: Connect (parks WARP first)"
LABEL_PROTON_OFF = "⏹️  Proton VPN: Disconnect → rebuild WARP"

desktop = os.environ.get('XDG_CURRENT_DESKTOP', '').lower()
home = os.path.expanduser('~')
ICON_GREEN = f"{home}/.local/share/icons/warp-green.svg"
ICON_RED = f"{home}/.local/share/icons/warp-red.svg"
ICON_PARKED = f"{home}/.local/share/icons/warp-parked.svg"
ICON_PROTON = f"{home}/.local/share/icons/proton-yellow.svg"
ICONS = (ICON_GREEN, ICON_RED, ICON_PARKED, ICON_PROTON)


def state():
    """(tooltip, icon path, proton_on). One probe per poll, in the cheap order."""
    if proton_connected():
        parked = is_parked()
        return ("Proton VPN on — WARP parked" if parked else "Proton VPN on — WARP off"), ICON_PROTON, True
    if check_status():
        return "Cloudflare WARP on", ICON_GREEN, False
    if is_parked():
        return "Cloudflare WARP — PARKED for Proton VPN, which is not connected. Rebuild from the menu.", ICON_PARKED, False
    if is_killed():
        return "Cloudflare WARP — KILLED (stack torn down)", ICON_RED, False
    return "Cloudflare WARP off", ICON_RED, False


def left_click():
    if proton_connected():
        notify('Cloudflare WARP', 'Disconnect Proton VPN first — the two cannot run together.',
               'network-error')
    elif check_status():
        warp_switch('disconnect')
        notify('Cloudflare WARP', 'Disconnected', 'network-offline')
    elif is_killed():
        # The daemon is stopped and disabled; warp-cli connect cannot work.
        notify('Cloudflare WARP',
               'WARP is parked/torn down — use Rebuild from the right-click menu.',
               'network-error')
    else:
        warp_switch('connect')
        notify('Cloudflare WARP', 'Connecting (Tunnel Only)…', 'network-vpn')


def rebuild():
    if proton_connected():
        notify('Cloudflare WARP', 'Disconnect Proton VPN first — the two cannot run together.',
               'network-error')
        return False
    killswitch('up')
    return True


if 'kde' in desktop:
    # --- KDE PLASMA (QT6) ---
    from PyQt6.QtCore import QTimer
    from PyQt6.QtGui import QAction, QIcon
    from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

    def toggle(reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            left_click()
            QTimer.singleShot(1500, update_ui)

    def update_ui():
        text, icon_path, proton_on = state()
        tray.setIcon(icons[icon_path])
        tray.setToolTip(text)
        act_proton.setText(LABEL_PROTON_OFF if proton_on else LABEL_PROTON_ON)

    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    icons = {p: QIcon(p) for p in ICONS}
    tray = QSystemTrayIcon()

    menu = QMenu()
    act_down = QAction(LABEL_DOWN)
    act_down.triggered.connect(lambda: (killswitch('down'), QTimer.singleShot(2500, update_ui)))
    act_up = QAction(LABEL_UP)
    act_up.triggered.connect(lambda: (rebuild(), QTimer.singleShot(6000, update_ui)))
    act_heal = QAction(LABEL_HEAL)
    act_heal.triggered.connect(lambda: (killswitch('heal'), QTimer.singleShot(6000, update_ui)))
    act_status = QAction(LABEL_STATUS)
    act_status.triggered.connect(show_status)
    act_proton = QAction(LABEL_PROTON_ON)
    act_proton.triggered.connect(
        lambda: (proton('off' if proton_connected() else 'on'), QTimer.singleShot(8000, update_ui)))
    menu.addAction(act_down)
    menu.addAction(act_up)
    menu.addSeparator()
    menu.addAction(act_heal)
    menu.addAction(act_status)
    if HAVE_PROTON:
        menu.addSeparator()
        menu.addAction(act_proton)
    tray.setContextMenu(menu)

    update_ui()
    tray.setVisible(True)
    tray.activated.connect(toggle)
    timer = QTimer()
    timer.timeout.connect(update_ui)
    timer.start(2000)
    sys.exit(app.exec())

else:
    # --- GTK: Cinnamon, MATE, XFCE, anything else ---
    # XApp.StatusIcon where libxapp is present (Cinnamon, MATE, XFCE on Mint
    # and its relatives): it speaks StatusNotifierItem and falls back to a
    # legacy status icon by itself. Elsewhere Gtk.StatusIcon, which every X11
    # notification area still accepts.
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import GLib, Gtk
    try:
        gi.require_version('XApp', '1.0')
        from gi.repository import XApp
        use_xapp = True
    except (ValueError, ImportError):
        from gi.repository import GdkPixbuf
        use_xapp = False

    def update_ui():
        text, icon_path, proton_on = state()
        if use_xapp:
            icon.set_icon_name(icon_path)
        else:
            pb = pixbufs.get(icon_path)
            if pb is not None:
                icon.set_from_pixbuf(pb)
            else:
                icon.set_from_icon_name('network-vpn')
        icon.set_tooltip_text(text)
        if mi_proton is not None:
            mi_proton.set_label(LABEL_PROTON_OFF if proton_on else LABEL_PROTON_ON)

    def poll_status():
        update_ui()
        return GLib.SOURCE_CONTINUE

    def later(delay):
        GLib.timeout_add(delay, lambda: update_ui() or GLib.SOURCE_REMOVE)

    def do_killswitch(action, delay):
        if action == 'up':
            rebuild()
        else:
            killswitch(action)
        later(delay)

    def do_proton(_w):
        proton('off' if proton_connected() else 'on')
        later(8000)

    menu = Gtk.Menu()
    mi_proton = None
    entries = [(LABEL_DOWN, lambda _w: do_killswitch('down', 2500)),
               (LABEL_UP, lambda _w: do_killswitch('up', 6000)),
               (None, None),
               (LABEL_HEAL, lambda _w: do_killswitch('heal', 6000)),
               (LABEL_STATUS, lambda _w: show_status())]
    if HAVE_PROTON:
        entries += [(None, None), (LABEL_PROTON_ON, do_proton)]
    for label, cb in entries:
        if label is None:
            menu.append(Gtk.SeparatorMenuItem())
            continue
        mi = Gtk.MenuItem(label=label)
        mi.connect("activate", cb)
        menu.append(mi)
        if label == LABEL_PROTON_ON:
            mi_proton = mi
    menu.show_all()

    if use_xapp:
        def on_click(_icon, _x, _y, button, _time, _pos):
            if button != 1:
                return
            left_click()
            later(1500)
        icon = XApp.StatusIcon()
        icon.connect("button-release-event", on_click)
        icon.set_secondary_menu(menu)
    else:
        def on_activate(_icon, _event=None):
            left_click()
            later(1500)

        def on_popup(_icon, button, time):
            menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, time)
        pixbufs = {}
        for p in ICONS:
            try:
                pixbufs[p] = GdkPixbuf.Pixbuf.new_from_file_at_size(p, 22, 22)
            except GLib.Error:
                pass  # icon not installed yet: fall back to a themed icon
        icon = Gtk.StatusIcon()
        icon.connect("activate", on_activate)
        icon.connect("popup-menu", on_popup)

    update_ui()
    GLib.timeout_add(2000, poll_status)
    Gtk.main()
